{
  "info": {
    "name": "Bookstore API",
    "description": "Complete API collection for Online Bookstore",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8089",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@bookstore.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Emily\",\n  \"lastName\": \"Smith\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/register"}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@bookstore.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/login"}
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/auth/me"}
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"user123\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/change-password"}
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@bookstore.com\",\n  \"firstName\": \"Michael\",\n  \"lastName\": \"Updated\",\n  \"role\": \"USER\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/profile"}
          }
        }
      ]
    },
